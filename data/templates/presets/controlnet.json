{
  "id": "controlnet",
  "name": "ControlNet",
  "category": "generation",
  "description": "ControlNet 控制生成工作流",
  "parameters": {
    "checkpoint": {
      "type": "model",
      "model_type": "checkpoints",
      "default": "sd_xl_base_1.0.safetensors",
      "required": true,
      "description": "基础模型"
    },
    "positive_prompt": {
      "type": "text",
      "default": "",
      "multiline": true,
      "description": "正向提示词"
    },
    "negative_prompt": {
      "type": "text",
      "default": "",
      "multiline": true,
      "description": "负向提示词"
    },
    "width": {
      "type": "number",
      "default": 1024,
      "min": 256,
      "max": 2048,
      "step": 64,
      "description": "宽度"
    },
    "height": {
      "type": "number",
      "default": 1024,
      "min": 256,
      "max": 2048,
      "step": 64,
      "description": "高度"
    },
    "steps": {
      "type": "number",
      "default": 20,
      "min": 1,
      "max": 100,
      "description": "采样步数"
    },
    "cfg": {
      "type": "number",
      "default": 8.0,
      "min": 1.0,
      "max": 30.0,
      "description": "CFG Scale"
    },
    "seed": {
      "type": "number",
      "default": -1,
      "random": true,
      "description": "随机种子"
    },
    "sampler_name": {
      "type": "select",
      "default": "euler",
      "options": ["euler", "euler_ancestral", "dpmpp_2m", "dpmpp_2m_sde", "dpmpp_3m_sde"],
      "description": "采样器"
    },
    "scheduler": {
      "type": "select",
      "default": "normal",
      "options": ["normal", "karras", "exponential", "sgm_uniform"],
      "description": "调度器"
    },
    "controlnet_model": {
      "type": "model",
      "model_type": "controlnet",
      "default": "control_v11p_sd15_canny.pth",
      "required": true,
      "description": "ControlNet 模型"
    },
    "strength": {
      "type": "number",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "description": "ControlNet 强度"
    }
  },
  "workflow": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "control.png"
      },
      "_meta": {
        "title": "Control Image"
      }
    },
    "3": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "control_v11p_sd15_canny.pth"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["1", 1]
      },
      "_meta": {
        "title": "Positive Prompt"
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["1", 1]
      },
      "_meta": {
        "title": "Negative Prompt"
      }
    },
    "6": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": ["4", 0],
        "negative": ["5", 0],
        "control_net": ["3", 0],
        "image": ["2", 0],
        "strength": 1.0,
        "start_percent": 0.0,
        "end_percent": 1.0
      }
    },
    "7": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["6", 0],
        "negative": ["6", 1],
        "latent_image": ["7", 0],
        "seed": 12345,
        "steps": 20,
        "cfg": 8.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["8", 0],
        "vae": ["1", 2]
      }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["9", 0],
        "filename_prefix": "ComfyUI_controlnet"
      }
    }
  }
}
